# Port the Express server listens on (default: 5000)
PORT=5000

# MongoDB connection string (Local or MongoDB Atlas)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/earts?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/earts

# Secret for signing JWT authentication tokens (use a long random value)
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated allowed frontend origins for CORS
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000

# Google OAuth Client ID (must match the frontend client ID)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Resend password-reset email settings
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL="Earts <onboarding@resend.dev>"
